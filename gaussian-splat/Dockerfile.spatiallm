FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

RUN apt-get update && apt-get install -y \
    git curl wget build-essential libsparsehash-dev \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN git clone https://github.com/manycore-research/SpatialLM.git

# Pin transformers to 4.x — 5.x breaks torch 2.4.1 compatibility
RUN pip install --upgrade pip

RUN pip install "transformers>=4.41.2,<5.0.0" "tokenizers>=0.19.0,<0.21" \
    "safetensors>=0.4.5" "huggingface_hub>=0.25.0" "accelerate"

RUN pip install "einops>=0.8.0" "plyfile>=1.0" "scipy>=1.10" \
    "scikit-learn>=1.3" "shapely>=2.0" "pandas>=2.0"

RUN pip install --no-cache-dir open3d

RUN pip install "addict" "toml" "bbox" "terminaltables" \
    "poethepoet" "runpod>=1.7.0" "requests"

ENV PYTHONPATH=/workspace/SpatialLM

WORKDIR /workspace/SpatialLM
RUN poe install-sonata

WORKDIR /workspace
COPY handler_spatiallm.py .

CMD ["python", "-u", "handler_spatiallm.py"]
