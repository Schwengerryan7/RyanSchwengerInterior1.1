# Floor Plan Extraction — Point Transformer V3 (MIT) + RoomFormer (MIT)
# Replaces SpatialLM (CC-BY-NC — not commercially licensed).
#
# Stage 1: PTv3 (Pointcept) — 3-D semantic segmentation, ScanNet-20 classes
# Stage 2: RoomFormer        — top-down density image → room polygons

FROM pytorch/pytorch:2.4.1-cuda12.4-cudnn9-devel

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    git curl wget build-essential ninja-build \
    libsparsehash-dev libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN pip install --upgrade pip

# ── Core dependencies shared by both models ───────────────────────────────────
RUN pip install \
    "plyfile>=1.0" "scipy>=1.10" "scikit-learn>=1.3" \
    "shapely>=2.0" "einops>=0.8" "timm>=0.9" \
    "addict" "yapf" "tensorboard" "tqdm" \
    "huggingface_hub>=0.25" \
    "runpod>=1.7.0" "requests"

# ── PyTorch Geometric extensions (required by Pointcept/PTv3) ─────────────────
# Use torch-2.4.0 wheel index — compatible with torch 2.4.1 ABI
RUN pip install torch_scatter torch_cluster torch_sparse \
    -f https://data.pyg.org/whl/torch-2.4.0+cu124.html || \
    pip install torch_scatter torch_cluster torch_sparse \
    -f https://data.pyg.org/whl/torch-2.4.0+cu121.html

# ── Flash Attention (Pointcept serialised attention) ──────────────────────────
RUN pip install flash-attn --no-build-isolation

# ── Pointcept (Point Transformer V3) ─────────────────────────────────────────
RUN git clone --depth 1 https://github.com/Pointcept/Pointcept.git /workspace/Pointcept

WORKDIR /workspace/Pointcept
# Compile pointops CUDA extensions
RUN pip install -e . --no-build-isolation

# Download PTv3 ScanNet-20 semantic segmentation weights from HuggingFace
RUN python - <<'EOF'
from huggingface_hub import hf_hub_download
import os
os.makedirs('/models/ptv3', exist_ok=True)
hf_hub_download(
    repo_id='Pointcept/PointTransformerV3',
    filename='scannet-semseg/model_best.pth',
    local_dir='/models/ptv3',
)
print('[PTv3] Weights downloaded.')
EOF

# ── RoomFormer ────────────────────────────────────────────────────────────────
WORKDIR /workspace
RUN git clone --depth 1 https://github.com/ywyue/RoomFormer.git /workspace/RoomFormer

WORKDIR /workspace/RoomFormer
RUN pip install -r requirements.txt --no-build-isolation

# Download RoomFormer pretrained weights from ETH Zurich Polybox.
# The archive contains checkpoints/ with roomformer_stru3d.pth and roomformer_scenecad.pth.
# roomformer_scenecad.pth is trained on Structured3D + SceneCAD (real-scan layout data)
# and gives the best results on COLMAP point clouds.
RUN mkdir -p /models/roomformer && \
    wget -q "https://polybox.ethz.ch/index.php/s/vlBo66X0NTrcsTC/download" \
         -O /tmp/roomformer_weights.zip && \
    unzip -q /tmp/roomformer_weights.zip -d /models/roomformer/ && \
    rm /tmp/roomformer_weights.zip && \
    echo "[RoomFormer] Weights extracted:" && \
    ls /models/roomformer/checkpoints/

# ── Handler ───────────────────────────────────────────────────────────────────
WORKDIR /workspace
COPY handler_floorplan.py .

ENV PYTHONPATH=/workspace/Pointcept:/workspace/RoomFormer

CMD ["python", "-u", "handler_floorplan.py"]
