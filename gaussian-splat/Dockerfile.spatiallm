FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

RUN apt-get update && apt-get install -y \
    git curl wget build-essential libsparsehash-dev \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN git clone https://github.com/manycore-research/SpatialLM.git

# Pin transformers to <=4.46.1 — 5.x breaks torch 2.4.1 compatibility
RUN pip install --upgrade pip && pip install \
    "transformers==4.46.1" \
    "tokenizers>=0.19.0,<0.20.4" \
    "safetensors>=0.4.5" \
    "huggingface_hub==0.36.2" \
    "einops==0.8.2" \
    "open3d==0.19.0" \
    "plyfile==1.1.3" \
    "numpy==1.26.4" \
    "scipy==1.17.1" \
    "scikit-learn==1.8.0" \
    "shapely==2.1.2" \
    "pandas>=2.2.3" \
    "addict" "toml" "bbox" "terminaltables" \
    "poethepoet" \
    "runpod==1.9.0" "requests"

ENV PYTHONPATH=/workspace/SpatialLM

WORKDIR /workspace/SpatialLM
RUN poe install-sonata

WORKDIR /workspace
COPY handler_spatiallm.py .

CMD ["python", "-u", "handler_spatiallm.py"]
