# SpatialLM RunPod Serverless Worker
# Base: PyTorch 2.4.1 + CUDA 12.4
FROM pytorch/pytorch:2.4.1-cuda12.4-cudnn9-runtime

RUN apt-get update && apt-get install -y \
    git curl wget \
    build-essential \
    libsparsehash-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Clone SpatialLM
RUN git clone https://github.com/manycore-research/SpatialLM.git
WORKDIR /workspace/SpatialLM

# Install poetry + deps
RUN pip install --upgrade pip poetry
RUN poetry config virtualenvs.create false --local
RUN poetry install --no-dev

# Install Sonata point-cloud backbone (required for SpatialLM 1.1)
RUN pip install poethepoet && poe install-sonata

# Additional deps for the handler
RUN pip install runpod plyfile requests

WORKDIR /workspace

# Copy handler
COPY handler_spatiallm.py .

# Model weights are downloaded at first cold start (avoids CI disk/network limits).
# To pre-bake them into a custom image, run this manually after building:
#   docker run --rm <image> python -c "from transformers import AutoModelForCausalLM, AutoTokenizer; AutoTokenizer.from_pretrained('manycore-research/SpatialLM1.1-Qwen-0.5B'); AutoModelForCausalLM.from_pretrained('manycore-research/SpatialLM1.1-Qwen-0.5B', torch_dtype='auto')"

CMD ["python", "-u", "handler_spatiallm.py"]
