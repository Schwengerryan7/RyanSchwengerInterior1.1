# SpatialLM RunPod Serverless Worker
# Uses devel image so nvcc is available for Sonata CUDA extension compilation
FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

RUN apt-get update && apt-get install -y \
    git curl wget build-essential libsparsehash-dev \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Clone SpatialLM
RUN git clone https://github.com/manycore-research/SpatialLM.git

# Install all deps with pip — skip torch/torchvision (already in base image)
RUN pip install --upgrade pip && pip install \
    "transformers>=4.41.2,<=4.46.1" \
    "safetensors>=0.4.5" \
    "pandas>=2.2.3" \
    "scipy>=1.15.2" \
    "scikit-learn>=1.6.1" \
    "einops>=0.8.1" \
    "huggingface_hub>=0.25.0" \
    "open3d>=0.18.0" \
    "shapely>=2.0.7" \
    "tokenizers>=0.19.0,<0.20.4" \
    "addict" "toml" "bbox" "terminaltables" \
    "poethepoet" \
    "runpod" "plyfile" "requests"

# Make SpatialLM importable without poetry
ENV PYTHONPATH=/workspace/SpatialLM

# Install Sonata point-cloud backbone (requires nvcc — needs devel image)
WORKDIR /workspace/SpatialLM
RUN poe install-sonata

WORKDIR /workspace
COPY handler_spatiallm.py .

CMD ["python", "-u", "handler_spatiallm.py"]
